{
  // Find providers from OpenCode configuration and authentication.
  // Provider selection: "auto" detects providers; an array tracks only listed providers.
  // Explicit list excludes OpenCode Zen ("opencode") whose negative balance the parser can't handle.
  "enabledProviders": ["opencode-go", "quota-providers"],

  // Custom provider: Neuralwatt credit balance from the account quota API.
  "quotaProviders": [
    {
      "id": "neuralwatt",
      "label": "Neuralwatt",
      "mode": "remote-api",
      "url": "https://api.neuralwatt.com/v1/quota",
      "format": "json-v1",
      "adapter": {
        "mappings": [
          {
            "resultType": "balance",
            "name": "Credit balance",
            "label": "Balance",
            "unit": "$",
            "unitPosition": "prefix",
            "metric": {
              "type": "value",
              "valueType": "balance",
              "value": { "path": ["balance", "credits_remaining_usd"] },
            },
          },
        ],
      },
    },
  ],

  // Show every quota reset period.
  // Quota presentation and reset-period choices.
  "formatStyle": "allWindows",
  "percentDisplayMode": "remaining",

  // Show slash-command results with normal TUI messages.
  "tuiCommandDisplay": "inline",

  // Show the detailed Quota panel in the TUI sidebar.
  // TUI-only surfaces.
  "tuiSidebarPanel": {
    "enabled": true,
  },

  // Keep the other automatic TUI displays off.
  // Automatic quota surfaces. Slash commands remain available when these are disabled.
  "enableToast": false,
  "tuiCompactStatus": {
    "enabled": false,
    "homeBottom": false,
    "sessionPrompt": true,
    "suppressWhenNativeProviderQuota": true,
  },

  // Show bundled maintainer notices on TUI Home.
  // Optional bundled maintainer Home announcements.
  "maintainerAnnouncements": {
    "enabled": false,
    "home": false,
  },
  // Include or hide current-session input and output token totals.
  "showSessionTokens": false,
}
