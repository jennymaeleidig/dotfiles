{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "websearch": "allow",
  },
  "plugin": [
    "context-mode",
    "opencode-hypa",
    "@slkiser/opencode-quota@latest",
    "@leohenon/opencode-vim-plugin",
    "opencode-vision",
    "@franlol/opencode-md-table-formatter@latest",
  ],
  "provider": {
    "opencode-go": {},
    // Detected opencode authentication; opencode-quota added this global provider declaration.
    "opencode": {
      "models": {
        "mimo-v2.5-free": {
          "name": "MiMo V2.5 Free",
          "status": "active",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
    // Detected deepseek authentication; opencode-quota added this global provider declaration.
    "deepseek": {},
  },
}
