{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "context-mode",
    "opencode-hypa",
    "@slkiser/opencode-quota@latest",
    "@leohenon/opencode-vim-plugin",
    "opencode-vision",
  ],
  "provider": {
    "opencode-go": {},
    // Detected opencode authentication; opencode-quota added this global provider declaration.
    "opencode": {},
    // Detected deepseek authentication; opencode-quota added this global provider declaration.
    "deepseek": {},
  },
  "formatter": {
    "csharpier": {
      "command": ["csharpier", "format", "$FILE"],
      "extensions": [".cs"],
      "environment": {
        "DOTNET_ROOT": "/Users/jennyleidig/.local/share/mise/dotnet-root",
      },
    },
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".md",
        ".html",
        ".css",
        ".yaml",
        ".yml",
      ],
    },
  },
  "lsp": {
    "csharp": {
      "command": ["csharp-ls"],
      "env": {
        "DOTNET_ROOT": "/Users/jennyleidig/.local/share/mise/dotnet-root",
      },
    },
  },
}
