# pi launch routing, in its own file so dot_bash_exports stays declarative.
# Sourced from ~/.bash_exports (a shell function, not a bin script: PNPM's bin
# is prepended after ~/.local/bin in dot_bashrc, so a script there would be
# shadowed by the real pi, while a function overrides PATH lookup outright).
#
# Rendered from .chezmoidata.toml's [chat.local]/[chat.remote] tables — the
# same tables the /online and /offline host-toggle extension renders from — so
# the wrapper and the extension cannot drift apart.
#
# `--online` is rewritten, not passed through: it injects the remote default
# only for the flags the caller didn't choose, so `pi --online --model glm-5.3`
# keeps glm-5.3. A bare launch falls back to full remote when the local server
# is unreachable (a down server only fails at the first message otherwise); an
# explicit --model/--provider skips the probe: the caller has already chosen.
#
# Both remote paths are full remote: the chat model from [chat.remote] and the
# judge stack from [judge.online]. tinysubagent reads its classifier config once
# at extension load, so the switch is a PI_TINYSUBAGENT_CONFIG export; pi-warden
# reads config.json once per session and never adopts a later file change, so
# the switch is a config swap that cannot affect sessions already running —
# they keep judging the way they launched. A local launch swaps the local
# config back, so the file always reflects the most recent launch.
pi() {
  local online=0 has_model=0 has_provider=0 fell_back=0
  local a
  local -a args=()
  for a in "$@"; do
    case "$a" in
      --online) online=1 ;;
      --model|--model=*) has_model=1; args+=("$a") ;;
      --provider|--provider=*) has_provider=1; args+=("$a") ;;
      *) args+=("$a") ;;
    esac
  done
  if [ "$online" = 0 ] && [ "$has_model" = 0 ] && [ "$has_provider" = 0 ] && ! curl -fsS --max-time 2 {{ .chat.local.host }}/v1/models >/dev/null 2>&1; then
    online=1
    fell_back=1
  fi
  if [ "$online" = 1 ]; then
    [ "$fell_back" = 1 ] && printf 'pi: local server unreachable at {{ .chat.local.host }} — starting full remote\n' >&2
    # tinysubagent: point this launch's classifier routing at the online judge,
    # unless the caller already chose a config. A later local launch in the
    # same shell unsets exactly this value, never one the caller set.
    if [ -z "${PI_TINYSUBAGENT_CONFIG:-}" ] && [ -f "$HOME/.pi/agent/tinysubagent.online.jsonc" ]; then
      export PI_TINYSUBAGENT_CONFIG="$HOME/.pi/agent/tinysubagent.online.jsonc"
    fi
    # pi-warden: swap the judgment backend for sessions launched from here on.
    [ -f "$HOME/.pi/agent/pi-warden/config.online.json" ] && cp "$HOME/.pi/agent/pi-warden/config.online.json" "$HOME/.pi/agent/pi-warden/config.json"
    local -a inject=()
    [ "$has_model" = 0 ] && inject+=(--model {{ .chat.remote.model }})
    [ "$has_provider" = 0 ] && inject+=(--provider {{ .chat.remote.provider }})
    command pi "${inject[@]}" "${args[@]}"
    return
  fi
  # Local: restore the local judge config an online launch may have left behind
  # and clear our own tinysubagent override.
  [ "${PI_TINYSUBAGENT_CONFIG:-}" = "$HOME/.pi/agent/tinysubagent.online.jsonc" ] && unset PI_TINYSUBAGENT_CONFIG
  [ -f "$HOME/.pi/agent/pi-warden/config.local.json" ] && cp "$HOME/.pi/agent/pi-warden/config.local.json" "$HOME/.pi/agent/pi-warden/config.json"
  command pi "${args[@]}"
}
