# Palette: external in .chezmoiexternal.toml (Kirlovon/monokai-ghostty).
# herdr-theme-sync reads this line to derive the herdr theme — keep it.
theme = "Monokai Pro"
background-opacity = 0.75
background-blur = true

# Font
# Family name, not PostScript name: Ghostty matches families only, so
# "CommitMonoNF" is not found and silently falls back to JetBrains Mono.
font-family = "CommitMono Nerd Font Mono"
# Fallback for codepoints CommitMono lacks (U+29C9 ⧉, U+21E1 ⇡), named so
# fallback selection is deterministic rather than CoreText's search order.
font-family = "STIX Two Math"
font-size = 14

# Quick terminal (ctrl+`): centered, unanimated. Defaults are top / 0.2s.
keybind = global:ctrl+backquote=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 100%,100%
quick-terminal-animation-duration = 0

# Keep the block cursor; shell integration otherwise forces a bar at the prompt.
shell-integration-features = no-cursor