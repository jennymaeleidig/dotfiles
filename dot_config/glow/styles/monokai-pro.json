{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#FCFCFA",
    "margin": 2
  },
  "block_quote": {
    "color": "#FFD866",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "color": "#FCFCFA",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#AB9DF2",
    "bold": true
  },
  "h1": {
    "prefix": "# ",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "bold": true
  },
  "h6": {
    "prefix": "###### ",
    "bold": true
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true,
    "color": "#FFD866"
  },
  "strong": {
    "bold": true,
    "color": "#FFD866"
  },
  "hr": {
    "color": "#5B595C",
    "format": "\n──────────────────────────────\n"
  },
  "item": {
    "block_prefix": "● "
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#78DCE8"
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#78DCE8",
    "underline": true
  },
  "link_text": {
    "color": "#FFD866",
    "bold": true
  },
  "image": {
    "color": "#78DCE8",
    "underline": true
  },
  "image_text": {
    "color": "#727072",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#FC9867",
    "background_color": "#2D2A2E"
  },
  "code_block": {
    "color": "#727072",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#FCFCFA"
      },
      "error": {
        "color": "#FCFCFA",
        "background_color": "#FF6188"
      },
      "comment": {
        "color": "#727072"
      },
      "comment_preproc": {
        "color": "#AB9DF2"
      },
      "keyword": {
        "color": "#FF6188"
      },
      "keyword_reserved": {
        "color": "#FF6188"
      },
      "keyword_namespace": {
        "color": "#FF6188"
      },
      "keyword_type": {
        "color": "#AB9DF2"
      },
      "operator": {
        "color": "#FF6188"
      },
      "punctuation": {
        "color": "#FCFCFA"
      },
      "name": {
        "color": "#A9DC76"
      },
      "name_builtin": {
        "color": "#78DCE8"
      },
      "name_tag": {
        "color": "#FF6188"
      },
      "name_attribute": {
        "color": "#A9DC76"
      },
      "name_class": {
        "color": "#AB9DF2",
        "bold": true
      },
      "name_constant": {
        "color": "#AB9DF2"
      },
      "name_decorator": {
        "color": "#FFD866"
      },
      "name_exception": {},
      "name_function": {
        "color": "#A9DC76"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {
        "color": "#AB9DF2"
      },
      "literal_date": {},
      "literal_string": {
        "color": "#FFD866"
      },
      "literal_string_escape": {
        "color": "#AB9DF2"
      },
      "generic_deleted": {
        "color": "#FF6188"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#A9DC76"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#AB9DF2"
      },
      "background": {
        "background_color": "#2D2A2E"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n➛ "
  },
  "html_block": {},
  "html_span": {}
}