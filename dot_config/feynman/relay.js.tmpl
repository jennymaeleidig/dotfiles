{{- /* Guest loopback relay for the feynman sandbox (docs/adr/0004): msb
publishes ports by dialing the guest's eth0 IP, but feynman binds its servers
to 127.0.0.1 inside the guest, so this relay exposes them on 0.0.0.0. Port
pairs come from .chezmoidata/feynman-sandbox.toml — edit there, not here.
Rendered into the sandbox config by sandbox.yaml.tmpl. */ -}}
const net = require('node:net');
const fwd = (listen, target) => {
	net.createServer((c) => {
		const u = net.connect(target);
		c.pipe(u);
		u.pipe(c);
		const kill = () => { c.destroy(); u.destroy(); };
		c.on('error', kill);
		u.on('error', kill);
	}).listen(listen, '0.0.0.0');
};
{{- range .feynmanSandbox.ports }}
fwd({{ .relay }}, { host: '127.0.0.1', port: {{ .service }} });
{{- end }}
