# Feynman runs inside this microsandbox microVM (msb). Loaded by the `feynman`
# shell function in bash_aliases; see docs/adr/0004-feynman-runs-in-a-microsandbox.md.
#
# msb schema: https://github.com/superradcompany/microsandbox/blob/main/docs/cli/configuration.mdx
# Strict YAML: no anchors, no unknown fields, quote typed strings.
# The guest patches are real source files (relay.js.tmpl, guest-feynman.sh)
# rendered in below; port pairs come from .chezmoidata/feynman-sandbox.toml.
image: "debian:trixie"
cpus: 4
memory: "4G"
workdir: "/root"

env:
  # Feynman spawns npm/npx by name (runtime workspace setup); the bundle
  # ships its own, so put its node/bin first on the guest PATH.
  PATH: "/opt/feynman/current/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

mounts:
  # Feynman state (auth, sessions, packages, workbench) shared host <-> guest,
  # so `feynman model login` on the host works inside the VM and vice versa.
  - "{{ .chezmoi.homeDir }}/.feynman:/root/.feynman"
  - "{{ .chezmoi.homeDir }}/.ahub:/root/.ahub"
  # Linux feynman bundle in an msb disk volume (raw ext4 via virtio-blk,
  # guest-native speed), populated by `feynman-vm-setup`. The guest wrapper
  # patch below execs /opt/feynman/current/feynman.
  - named: feynman
    target: "/opt/feynman"

patches:
  # Guest loopback relay: exposes the guest's loopback-only services on
  # 0.0.0.0 (see relay.js for the pair map).
  - text:
      path: "/opt/relay.js"
      content: {{ includeTemplate "dot_config/feynman/relay.js.tmpl" . | toJson }}
      mode: "0644"
  # Guest entry point: start the relay, then exec the launcher inside the
  # bundle (a symlink would break the launcher's own ROOT resolution).
  - text:
      path: "/usr/local/bin/feynman"
      content: {{ include "dot_config/feynman/guest-feynman.sh" | toJson }}
      mode: "0755"

# Public internet egress (model providers, paper APIs); private/metadata blocked.
network: public

# Host -> relay mapping (see relay.js and .chezmoidata/feynman-sandbox.toml):
# workbench and OAuth callback.
ports:
{{- range .feynmanSandbox.ports }}
  - "{{ .host }}:{{ .relay }}"
{{- end }}

# Provider API keys stay host-side and are injected per-domain; uncomment and
# add keys as needed (values come from the host environment):
# secrets:
#   OPENROUTER_API_KEY:
#     allow: ["openrouter.ai"]
