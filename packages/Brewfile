# Package manifest for both hosts, consumed by
# .chezmoiscripts/run_onchange_before_10-brew-bundle.sh.tmpl, which hashes this
# file: an edit here re-runs `brew bundle` on the next apply.
#
# Ownership, do not cross the lines:
#   mise   -> every language runtime and language tool (node, python, go, bun,
#             dotnet, pnpm, rust, uv, ruff, prettier, zoxide, typescript)
#   apt    -> the Linux system layer (packages/apt-ubuntu.txt)
#   brew   -> CLI utilities, plus casks and macOS-only formulae
#
# Casks need no OS guard: Homebrew's Linux bundle skipper drops any cask whose
# source does not declare linux support. Formulae have no such skipper, so
# anything apt owns on Linux is fenced with `if OS.mac?`.
#
# Tailscale is the tailscale-app cask on macOS: the app ships and supervises
# its own privileged daemon. On Linux the daemon comes from apt (the official
# repo, in packages/apt-ubuntu.txt). The brew formula and the App Store build
# each ship a daemon too, and any two of the three share one state directory,
# so never install another beside the cask.

# --- third-party taps -------------------------------------------------------
# `trusted: true` records trust but does not create the tap, so declare both:
# a fresh machine has neither, and an untapped tap cannot be recovered from the
# entries below alone.
#
# This tap serves both platforms, so it is not fenced with the macOS-only taps
# below. dot_pi/agent/mcp.json runs `kagi mcp`, which fails to spawn without it.
tap "Microck/kagi", "https://github.com/Microck/homebrew-kagi"

# Both remaining taps serve only macOS formulae and casks, so both are fenced.
# A tap that cannot be cloned fails `brew bundle` outright, unlike a cask whose
# source does not declare linux support, which is skipped.
if OS.mac?
  # The repository is jundot/omlx, not the jundot/homebrew-omlx the bare name
  # implies, so without the URL a fresh host asks git for credentials for a
  # repository that does not exist. This is the remote the tap is already on.
  tap "jundot/omlx", "https://github.com/jundot/omlx"
  tap "nikitabobko/tap"
  # Sideloadly has no homebrew/cask cask. This tap wraps the official
  # sideloadly.io DMG with `version :latest`, so it tracks upstream's releases
  # without a pinned checksum.
  tap "playcover/playcover", "https://github.com/PlayCover/homebrew-playcover"
end

# --- CLI utilities: same package on both platforms ---------------------------
brew "bash-completion@2"
brew "bat"
brew "chezmoi"
brew "eza"
brew "fd"
brew "fzf"
brew "gh"
# dot_gitconfig declares the LFS filter as required, so a host without git-lfs
# fails every checkout that carries LFS attributes instead of degrading.
brew "git-lfs"
brew "herdr"
brew "kagi", trusted: true
brew "mise"
brew "shellcheck"
brew "starship"
brew "tlrc"

# --- macOS-only formulae -----------------------------------------------------
if OS.mac?
  # macOS ships bash 3.2.57 from 2007 and keeps it at /bin/bash under SIP.
  # Installed side by side rather than replacing it: brew's prefix already
  # precedes /bin in dot_bashrc's PATH, so `bash` and `#!/usr/bin/env bash`
  # pick this one up, and only the login shell needs changing (below).
  brew "bash"
  # Haskell / Tidal Cycles. GHC lives here rather than in mise: cabal needs a
  # real GHC prefix, and ghcup itself is deliberately absent because it and
  # brew's ghc fight over the same paths.
  brew "cabal-install"
  brew "ghc"

  brew "cabextract"
  brew "ccache"
  brew "cmake"
  brew "czkawka"
  brew "duti"
  # Declared directly: ffmpeg used to arrive only as a dependency of a formula
  # that is no longer in this manifest, and yt-dlp needs it to mux.
  brew "ffmpeg"
  brew "hf"
  brew "imagemagick"
  brew "jq"
  brew "jundot/omlx/omlx", trusted: true
  brew "lima-additional-guestagents"
  # Declared directly: llvm arrived only as a stale dependency of ghc, so cleanup
  # removed it and took clangd with it, while dot_bash_exports.tmpl still points
  # LDFLAGS/CPPFLAGS at /opt/homebrew/opt/llvm.
  brew "llvm"
  brew "neovim"
  brew "p7zip"
  brew "pandoc"
  brew "pipx"
  brew "omlahore/tap/removemacai", trusted: true
  brew "ripgrep"
  brew "tree"
  brew "universal-ctags"
  brew "wget"
  brew "yt-dlp"

  # Containers: CLI only. Colima provides the Linux VM on macOS; on Linux
  # dockerd is native and comes from apt.
  brew "colima"
  brew "docker"
  brew "docker-buildx"
  brew "docker-compose"
end

# --- casks -------------------------------------------------------------------
if OS.mac?
  # Fully qualified: `brew bundle cleanup` only counts a tap as referenced when a
  # manifest entry names it. A bare `cask "aerospace"` left nikitabobko/tap
  # looking orphaned, so cleanup scheduled the tap for untapping and then failed
  # loading the cask whose source it was removing.
  cask "nikitabobko/tap/aerospace", trusted: true
  cask "betterdisplay"
  cask "bitwarden"
  cask "calibre"
  cask "discord"
  cask "font-commit-mono-nerd-font"
  cask "ghostty"
  # Chrome for Testing has no cask, and puppeteer's stable channel — what
  # dot_pi/agent/mcp.json's chrome-devtools server launches — resolves only
  # /Applications/Google Chrome.app, so the stable channel comes from here.
  cask "google-chrome"
  cask "grandperspective"
  cask "jdownloader"
  cask "karabiner-elements"
  cask "middle"
  cask "obs"
  cask "obsidian"
  # qBittorrent is absent deliberately: homebrew-cask disabled it and every
  # qBittorrent variant on 2026-09-01 because the app does not pass the macOS
  # Gatekeeper check. Install it from qbittorrent.org instead; see README.
  cask "raycast"
  cask "playcover/playcover/sideloadly", trusted: true
  cask "steam"
  cask "superwhisper"
  # App plus CLI; see the platform note at the top of this file.
  cask "tailscale-app"
  cask "visual-studio-code"
  cask "vlc"
  cask "vorssaint"
  cask "zen"
  cask "zotero"

  # Adopted from a manual install, in place, with
  # `brew install --cask --adopt <token>`. Not a batch install: adopt one at a
  # time, quit the app first, and confirm licences survive.
  cask "lulu"
  cask "midi-monitor"
  cask "onedrive"
  cask "onyx"
end

# Only the font installs through Homebrew on Linux: it is the one cask whose
# source declares arm64_linux. Ghostty (snap), VS Code (.deb repo) and Zen
# (flatpak) are installed outside brew bundle, so nothing double-installs.
if OS.linux?
  cask "font-commit-mono-nerd-font"
end