# Source-only artifacts never reach a host.
#
# One explicit path or pattern per line; a blanket `*.md` rule is forbidden
# because it would swallow applied markdown under dot_pi/agent/.
README.md
**/README.md

bootstrap.sh

# Root rules file: source-only, never a host file. Every _nested_ AGENTS.md is
# source-only too, except the agent domain one, which deploys to
# ~/.pi/agent/AGENTS.md — excludes take priority over includes.
AGENTS.md
**/AGENTS.md
!.pi/agent/AGENTS.md
docs/
tools/ 
.scratch/

# Agent domain docs: /domain-modeling creates these lazily. Source-only, never
# a host file. The pi-context glossary sits under the deployed dot_pi/ dir, so
# it is listed explicitly (a blanket \*.md is forbidden - it would swallow
# applied markdown under dot_pi/agent/).
GLOSSARY.md
**/GLOSSARY.md
GLOSSARY-MAP.md
**/GLOSSARY-MAP.md

# Runtime state (target side) — pi package trees materialized imperatively on
.pi/agent/npm/
.pi/agent/git/
.pi/cache/

# Runtime state (target side) — written by the herdr integration into an
# extensions dir that has no Source counterpart.
.pi/agent/extensions/herdr-agent-state.ts

# Python bytecode (target side) — created when a vendored plugin script is run
# or compiled on the host; never Source state.
**/__pycache__/

# Runtime state (source side) — files the tools may drop in the source directory, never reach a host
.vscode/

# Package manifests: source-only, consumed by .chezmoiscripts. The directory
# pattern ignores the directory and everything under it.
packages/

{{ if ne .chezmoi.os "darwin" }}
# macOS-only targets: a Linux guest has one window and no Colima, so neither
# config has meaning there. Patterns match the TARGET path, not dot_*.
.aerospace.toml
.colima/
.colima/**
{{ end }}

{{ if ne .chezmoi.os "linux" }}
# Linux-only: the snap's GL fallback wrapper.
.local/bin/ghostty
.local/share/applications/ghostty_ghostty.desktop
{{ end }}

