#!/usr/bin/env python3
"""txc-safe: wrap TeXicode (txc) so fenced code blocks are not parsed as TeX.

Reads markdown from stdin, replaces fenced code blocks with placeholders,
runs txc on the rest, then restores the original code blocks.
All txc CLI flags are forwarded transparently.

Why: txc's process_markdown() applies the LaTeX math regex to the entire
document, so $ inside ```bash ... ``` code blocks gets treated as TeX delimiters.
"""

import sys
import re
import subprocess
import os


def find_txc():
    """Find the real txc binary on PATH."""
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "txc")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            # Skip ourselves if named txc-safe (shouldn't conflict, but paranoia)
            return candidate
    print("txc-safe: could not find txc on PATH", file=sys.stderr)
    sys.exit(1)


def main():
    args = sys.argv[1:]
    txc_bin = find_txc()

    content = sys.stdin.read()

    # Replace fenced code blocks with numbered placeholders
    blocks = []

    def save_block(m):
        blocks.append(m.group(0))
        return f"__TXC_SAFE_BLOCK_{len(blocks) - 1}__"

    protected = re.sub(r"```[\s\S]*?```", save_block, content)

    # Run real txc on the protected content
    result = subprocess.run(
        [txc_bin] + args,
        input=protected,
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        print(result.stderr, file=sys.stderr, end="")
        sys.exit(result.returncode)

    # Restore code blocks in txc's output
    output = result.stdout
    for i, block in enumerate(blocks):
        output = output.replace(f"__TXC_SAFE_BLOCK_{i}__", block)

    sys.stdout.write(output)


if __name__ == "__main__":
    main()
