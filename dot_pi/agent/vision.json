{
  "provider": "opencode-go-vision",
  "model": "deepseek-v4.1-flash",
  "maxDimension": 1568,
  "jpegQuality": 85,
  "defaultReasoningEffort": "low",
  "enabled": true,
  "systemPrompt": null,
  "cacheEnabled": true,
  "cachePersist": true,
  "cacheMaxEntries": 256,
  "retryAttempts": 2,
  "retryBackoffMs": 500,
  "fallbackProvider": "opencode-go-vision",
  "fallbackModel": "glm-5.3-flash",
  "markerStyle": "code",
  "textOnlyPasteMode": "auto",
  "autoDelegatePrompt": "Describe this image concisely, focusing on visible content, text, diagrams, and layout.",
  "autoDelegateTimeoutMs": 30000,
  "composePreview": true,
  "previewMaxWidthCells": 80,
  "batchConcurrency": 5,
  "auditLog": true,
  "auditLogPath": null,
  "localOnly": false,
  "autoDetectVisionModel": false
}
