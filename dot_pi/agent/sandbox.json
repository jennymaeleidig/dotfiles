{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 0,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowedDomains": [
      "*"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "allowRead": [
      ".",
      "~/.pi",
      "~/.gitconfig",
      "~/.cc-safety-net",
      "~/.docker",
      "~/.colima",
      "~./agent/sandbox.json",
      "/opt/homebrew/Cellar",
      "/private/var/folders/*/pi-clipboard-*.png",
      "/var/folders/*/*/T/**",
      "/private/var/folders/*/*/T/**"
    ],
    "allowWrite": [
      ".",
      "~/.pi/agent/sessions",
      "~/.pi/agent/agent-memory",
      "$TMPDIR",
      "/tmp"
    ],
    "denyWrite": [
      "~/.local/share/chezmoi/dot_pi/agent/sandbox.json",
      "~/.cc-safety-net"
    ]
  }
}