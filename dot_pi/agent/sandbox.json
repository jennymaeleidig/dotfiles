{
  "enabled": true,
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      ".",
      "~/.local",
      "~/.config",
      "~/Library",
      "~/.pi",
      "~/.gitconfig",
      "~/.cc-safety-net",
      "~/.docker",
      "~/.colima",
      "~/.npm",
      "~/.cargo",
      "/opt/homebrew/Cellar",
      "/private/var/folders/*/pi-clipboard-*.png",
      "/var/folders/*/*/T/**",
      "/private/var/folders/*/*/T/**"
    ],
    "allowWrite": [
      ".",
      "~/.pi/agent/sessions",
      "~/.pi/agent/agent-memory",
      "/tmp",
      "/private/tmp",
      "~/.npm",
      "/private/var/folders/*/*/T/**"
    ],
    "denyWrite": [
      "~/.local/share/chezmoi/dot_pi/agent/sandbox.json",
      "~/.cc-safety-net"
    ]
  },
  "tools": {
    "ffgrep": {
      "fields": [
        "path"
      ],
      "access": "read"
    },
    "fffind": {
      "fields": [
        "path"
      ],
      "access": "read"
    },
    "fetch_content": {
      "fields": [],
      "access": "none"
    },
    "web_search": {
      "fields": [],
      "access": "none"
    },
    "source_check": {
      "fields": [],
      "access": "none"
    },
    "get_search_content": {
      "fields": [],
      "access": "none"
    },
    "subagent": {
      "fields": [],
      "access": "none"
    },
    "subagent_report": {
      "fields": [],
      "access": "none"
    },
    "update_plan": {
      "fields": [],
      "access": "none"
    },
    "recall": {
      "fields": [],
      "access": "none"
    },
    "obs_recall": {
      "fields": [],
      "access": "none"
    },
    "resolve-library-id": {
      "fields": [],
      "access": "none"
    },
    "query-docs": {
      "fields": [],
      "access": "none"
    },
    "load_tools": {
      "fields": [],
      "access": "none"
    },
    "call_tool": {
      "passThrough": {
        "tool": "tool",
        "params": "params"
      }
    }
  }
}