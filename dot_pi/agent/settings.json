{
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "defaultThinkingLevel": "high",
  "editorPaddingX": 0,
  "enabledModels": [
    "zai/glm-5.3-flash",
    "openrouter/z-ai/glm-5.3-flash"
  ],
  "enableInstallTelemetry": false,
  "hideThinkingBlock": true,
  "lastChangelogVersion": "0.85.1",
  "lazyTools": {
    "defer": [
      "Defer(web_*)",
      "zai_web_search",
      "resolve-library-id",
      "query-docs",
      "recall",
      "format_md_tables",
      "mermaid_lint"
    ],
    "noDefer": [],
    "deferToolLoading": true
  },
  "markdown": {
    "mermaid": "final"
  },
  "oppiMirror": {
    "autoStart": false,
    "workspaceCreation": "never"
  },
  "outputPad": 0,
  "packageDocs": [
    {
      "npm:pi-vim": "https://github.com/lajarre/pi-vim"
    },
    {
      "npm:@ff-labs/pi-fff": "https://github.com/dmtrKovalenko/fff/tree/main/packages/pi-fff"
    },
    {
      "npm:pi-markdown-preview": "https://github.com/omaclaren/pi-markdown-preview"
    },
    {
      "npm:@narumitw/pi-btw": "https://github.com/narumiruna/pi-extensions/tree/main/packages/pi-btw"
    },
    {
      "npm:pi-zentui": "https://github.com/lmilojevicc/pi-zentui"
    },
    {
      "npm:oppi-mirror": "https://github.com/duh17/oppi/tree/main/pi-extensions/oppi-mirror"
    },
    {
      "npm:@upstash/context7-pi": "https://github.com/upstash/context7"
    },
    {
      "npm:@bigboss2063/pi-clip": "https://github.com/bigboss2063/pi-clip"
    },
    {
      "npm:cc-safety-net": "https://github.com/kenryu42/cc-safety-net"
    },
    {
      "npm:pi-sandbox": "https://github.com/carderne/pi-sandbox"
    },
    {
      "npm:pi-extmgr": "https://github.com/ayagmar/pi-extmgr"
    },
    {
      "npm:pi-mermaid": "https://github.com/Gurpartap/pi-mermaid"
    },
    {
      "npm:@estebanforge/pi-glm-tweaks": "https://github.com/EstebanForge/pi-glm-tweaks"
    },
    {
      "npm:donsetch": "https://github.com/dondai44423/donsetch"
    },
    {
      "npm:pi-blackhole": "https://github.com/k0valik/pi-blackhole"
    },
    {
      "npm:pi-context-view": "https://github.com/dimk90/pi-context-view"
    },
    {
      "git:github.com/studyzy/pi-lazy-tools": "https://github.com/studyzy/pi-lazy-tools"
    },
    {
      "npm:@krfantasy/pi-monokai-pro":"https://github.com/krfantasy/pi-monokai-pro"
    },
    {
      "npm:pi-compact-transcript":"https://github.com/avhagedorn/pi-compact-transcript"
    }
  ],
  "packages": [
    "npm:pi-vim",
    "npm:@ff-labs/pi-fff",
    "npm:pi-markdown-preview",
    "npm:@narumitw/pi-btw",
    "npm:pi-zentui",
    "npm:oppi-mirror",
    "npm:@upstash/context7-pi",
    "npm:@bigboss2063/pi-clip",
    "npm:cc-safety-net",
    "npm:pi-sandbox",
    "npm:pi-extmgr",
    "npm:pi-mermaid",
    "npm:@estebanforge/pi-glm-tweaks",
    "npm:donsetch",
    "npm:pi-blackhole",
    "npm:pi-context-view",
    "git:github.com/studyzy/pi-lazy-tools",
    "npm:@krfantasy/pi-monokai-pro",
    "npm:pi-compact-transcript"
  ],
  "piVim": {
    "modeColors": {
      "insert": "text",
      "normal": "accent"
    }
  },
  "quietStartup": true,
  "showHardwareCursor": true,
  "terminal": {
    "showImages": true
  },
  "tuiMode": "fullscreen",
  "theme": "Monokai Pro (CE)",
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree"
}