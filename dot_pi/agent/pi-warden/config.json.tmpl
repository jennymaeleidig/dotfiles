{{- $registry := list "typesafe" "openrouter" "commandcode" "liquid" "subq" "nace" -}}
{{- $endpoint := not (has .judge.provider $registry) -}}
{
  "typesafe": true,
  "typesafeBackend": {{ if $endpoint }}{{ dict "label" .judge.label "host" .judge.host "path" .judge.path "keyEnv" .judge.keyEnv "defaultModel" .judge.model | toJson }}{{ else }}"{{ .judge.provider }}"{{ end }},
  "action": {
    "enabled": false,
    "tools": [],
    "ask": { "enabled": false },
    "traceSample": 0,
    "feedbackLog": false
  },
  "rules": {
    "enabled": true,
    "files": [
      "{{ .chezmoi.homeDir }}/.pi/agent/pi-warden/rules/global.md",
      "warden-local-rules.md"
    ],
    "fallback": false,
    "skip": [".scratch/**", "docs/agents/**", "CONTEXT-MAP.md"],
    "threshold": 0.7,
    "softThreshold": 0
  },
  "rulesAtTurnStart": {
    "enabled": true
  },
  "stuck": { "enabled": false },
  "done": { "enabled": false },
  "cause": { "enabled": false },
  "slop": { "enabled": false, "prose": { "enabled": false } },
  "security": { "enabled": false },
  "context": { "enabled": false, "largeOutput": { "enabled": false }, "filter": { "enabled": false } },
  "runaway": { "enabled": false },
  "subagent": { "enabled": false },
  "conscience": { "enabled": false },
  "prefs": { "enabled": false },
  "waste": { "enabled": false },
  "notify": { "enabled": false },
  "compaction": { "enabled": false },
  "widget": { "enabled": false },
  "trial": { "silentHalf": false }
}