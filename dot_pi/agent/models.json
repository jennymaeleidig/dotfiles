{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "opencode-go-vision": {
      "baseUrl": "https://opencode.ai/inference/go/openai/v1",
      "api": "openai-completions",
      "apiKey": "!pi auth print-api-key --provider opencode-go",
      "headers": {
        "x-opencode-session": "pi-getpipher-vision"
      },
      "models": [
        {
          "id": "deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash (vision delegate)",
          "input": ["text", "image"],
          "reasoning": true,
          "contextWindow": 128000,
          "maxTokens": 8192
        },
        {
          "id": "glm-5.3-flash",
          "name": "GLM 5.3 Flash (vision fallback)",
          "input": ["text", "image"],
          "reasoning": true,
          "contextWindow": 128000,
          "maxTokens": 8192
        }
      ]
    }
  }
}
