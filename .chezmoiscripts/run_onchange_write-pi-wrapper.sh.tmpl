#!/bin/bash
set -euo pipefail
# Materializes ~/.local/bin/pi with the exec bit — chezmoi strips +x from plain
# dotfiles (755 source -> 644 target), so the wrapper is written by an onchange
# script instead. Editing the wrapper text below changes this script's content,
# which reruns it via chezmoi's content-hash mechanism.
mkdir -p "$HOME/.local/bin"
cat > "$HOME/.local/bin/pi" <<'WRAPPER'
#!/usr/bin/env bash
# chezmoi-managed wrapper: applies --exclude-tools to every pi session launch
# regardless of the launching shell (bash, zsh, VS Code integrated terminal).
# Single source of truth for the exclusion list — dot_bash_aliases no longer
# carries it. If pi ever moves out of Homebrew, update this path.
#
# --exclude-tools is injected for interactive/print sessions ONLY. pi dispatches
# one-shot subcommands (install/remove/update/list/config/auth) by args[0]; a
# leading flag makes it treat "install npm:..." as a chat prompt and open the
# TUI/file-picker instead. See parsePackageCommand in dist/package-manager-cli.js.
set -euo pipefail
EXTRA=()
case "${1:-}" in
  install|remove|uninstall|update|list|config|auth) ;;
  *) EXTRA=(--exclude-tools bash,read,ls,hypa_grep,hypa_find) ;;
esac
exec /opt/homebrew/bin/pi "${EXTRA[@]}" "$@"
WRAPPER
chmod +x "$HOME/.local/bin/pi"