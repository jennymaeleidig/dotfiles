#!/bin/bash
set -euo pipefail
#
# Registers the llama-state sidebar plugin from the llm-serve checkout. The
# plugin's source is not in this repo: it ships in the llm-serve external
# (.chezmoiexternal.toml) and registers itself via `llm herdr --install`,
# which reconciles a moved checkout by unlinking the stale path first.
# Editing this script changes its content hash and reruns it (onchange
# mechanism).
#
cd "$HOME"

if ! command -v herdr >/dev/null 2>&1; then
	echo "==> herdr not installed; skipping llama-state registration"
	exit 0
fi

LLM="$HOME/.local/share/llm-serve/bin/llm"

# The git-repo external refreshes on its own schedule, so the checkout can be
# behind origin right after a push; pull --ff-only here so registration never
# runs a stale CLI. ff-only on purpose: a diverged checkout is an owner
# problem, and an apply script must not resolve it.
if [ -d "$HOME/.local/share/llm-serve/.git" ]; then
	git -C "$HOME/.local/share/llm-serve" pull --ff-only --quiet
fi

if [ ! -x "$LLM" ]; then
	echo "==> llm-serve checkout missing; skipping llama-state registration" >&2
	exit 1
fi

exec "$LLM" herdr --install
