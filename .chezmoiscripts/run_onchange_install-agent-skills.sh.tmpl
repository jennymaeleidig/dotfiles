#!/bin/bash
set -euo pipefail
#
# Installs third-party pi agent skills via the `skills` CLI.
#
# Destination: the CLI's pi adapter writes global skills to ~/.agents/skills
# (skills >= 1.7.1; <= 1.7.0 wrote ~/.pi/agent/skills). Pi scans
# ~/.pi/agent/skills before ~/.agents/skills and keeps the first of a colliding
# name, so the two dirs must never both hold a skill. ~/.pi/agent/skills is
# reserved for authored skills (chezmoi-managed under dot_pi/agent/skills) and
# Apply prunes any third-party tree left there; ~/.agents/skills is runtime
# state chezmoi does not manage, so it survives Apply and this script is its
# parity source.
#
# `npx skills@latest` is unpinned: a CLI release can move the destination
# again. If name collisions reappear, diff the pi adapter's globalSkillsDir.
#
# Editing this script changes its content hash, which reruns it (onchange
# mechanism).
#
# Parity: the `add` commands below are the single source of truth for
# third-party pi skills. Every run first removes ALL previously installed
# CLI-installed (github-sourced) pi skills, then reinstalls exactly the set
# named below — so deleting a line uninstalls that skill instead of orphaning
# it. Authored skills (sourceType != github; chezmoi-managed under
# dot_pi/agent/skills, re-included in .chezmoiignore) are preserved
# automatically and never touched.
#
cd "$HOME"

echo "==> Removing previously installed third-party pi skills..."
INSTALLED="$(npx -y skills ls -g --json 2>/dev/null |
	python3 -c "import json,sys; print('\n'.join(s['name'] for s in json.load(sys.stdin) if s.get('sourceType')=='github'))")"
if [ -n "$INSTALLED" ]; then
	# shellcheck disable=SC2086
	npx -y skills remove -g -a pi -y $INSTALLED
fi

echo "==> Installing third-party pi agent skills..."

npx -y skills@latest add https://github.com/petergyang/no-ai-slop \
	--skill no-ai-slop -g -a pi -y

# mattpocock/skills: install only the curated "base" set (the 21 skills
# listed in the repo's .claude-plugin/plugin.json). Without -s the CLI
# defaults to --skill '*' and installs all 35, including in-progress/misc.
npx -y skills@latest add mattpocock/skills -g -a pi -y \
	-s code-review codebase-design diagnosing-bugs domain-modeling \
	grill-with-docs implement improve-codebase-architecture prototype \
	research resolving-merge-conflicts setup-matt-pocock-skills tdd to-spec \
	to-tickets wayfinder wizard \
	grill-me grilling handoff teach writing-for-agents

npx -y skills@latest add herdrdev/herdr --skill herdr -g -a pi -y

echo "==> Installed global skills:"
npx -y skills ls -g --json | grep '"name"'
