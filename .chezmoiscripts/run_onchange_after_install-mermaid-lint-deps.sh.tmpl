#!/bin/bash
set -euo pipefail
#
# Materializes the mermaid-lint extension's runtime dependencies. Its source
# (index.ts, package.json) is Source state under dot_pi/agent/extensions/
# mermaid-lint/; its node_modules/ is runtime state excluded from target state
# in .chezmoiignore, exactly like the pi package trees (docs/adr/0004).
#
# `after_` attribute, not `onchange` interleaved alphabetically with file
# updates: default (unordered) scripts run while dotfiles are being applied,
# and this script's source path sorts before dot_pi/ — so without `after_`
# it runs before package.json exists on target and npm install fails
# (docs: use-scripts-to-perform-actions.md, script ordering). Editing this
# script changes its content hash and reruns it (onchange mechanism) — the
# same contract as the skills and mise installers.
#
cd "$HOME"

EXT="$HOME/.pi/agent/extensions/mermaid-lint"

echo "==> Installing mermaid-lint extension dependencies..."
npm install --prefix "$EXT" --omit=dev --no-audit --no-fund

echo "==> Done."
