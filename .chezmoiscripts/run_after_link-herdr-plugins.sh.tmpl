#!/bin/bash
set -euo pipefail
#
# Registers locally-vendored herdr plugins with herdr. Plugin source lives in
# dot_local/share/herdr/<directory> (Source state); `herdr plugin link` records the
# path in runtime state (~/.config/herdr/plugins.json), which Apply leaves
# alone. A plain `run_after_` script, not `run_onchange_`: every apply re-checks,
# so a host provisioned without a server converges the first time one is running.
# Re-checking is not re-linking: when the registry already matches the desired
# set, the script exits without touching it (see the stamp below).
#
# Install is deferred to the user: this script runs only on `chezmoi apply`,
# links source already present on the host, and is a no-op without herdr.
#
cd "$HOME"

# herdr arrives from packages/Brewfile, so it is on PATH only once brew's bin is,
# and no script inherits shellenv from 00-bootstrap. Without this the check below
# skips the whole script on Linux while reporting success.
# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/packages/script-env.sh"
brew_env

if ! command -v herdr >/dev/null 2>&1; then
	echo "==> herdr not installed; skipping plugin link"
	exit 0
fi

# The plugin registry lives behind herdr's server, and a headless apply has none:
# `herdr plugin link` fails with server_not_running instead of recording anything.
# The probe is a plugin command, not `herdr status`: status exits 0 without a
# server, so it never detected the case this guards against.
if ! herdr plugin list >/dev/null 2>&1; then
	echo '==> herdr server not running; start `herdr` once, then re-run: chezmoi apply' >&2
	exit 0
fi

# id|source path — one entry per vendored plugin. The two are named separately
# because a directory need not match its plugin id (the ghostty-theme-sync
# directory holds the plugin id herdr-theme-sync).
PLUGINS=(
	"herdr-theme-sync|$HOME/.local/share/herdr/ghostty-theme-sync"
)

# Plugins whose source is owned by another tool, so its absence is expected
# rather than a broken apply: the tinysubagent herdr plugin ships inside the pi
# package clone for `git:github.com/tinypi-extension/tinysubagent`
# (dot_pi/agent/settings.json), which exists only once pi has installed it.
# Kept apart from PLUGINS because a missing vendored source must fail the apply
# while a missing external clone must not.
OPTIONAL_PLUGINS=(
	"tinysubagent-panes|$HOME/.pi/agent/git/github.com/tinypi-extension/tinysubagent/herdr-plugin"
)

# The id|source set this host last linked, one per line. Target-side runtime
# state, and unmanaged by construction: nothing in Source names this path, so it
# needs no .chezmoiignore entry and no .chezmoiremove one either. XDG_STATE_HOME
# is unset on both hosts today, hence the fallback.
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/herdr-plugins.linked"

# Read the registry once, into a variable. Piping `herdr plugin list` into
# `grep -q` looks equivalent and is not: grep exits at the first match, the
# producer dies of SIGPIPE, and under `set -o pipefail` the pipeline reports
# 141, so the unlink below is silently skipped.
INSTALLED="$(herdr plugin list 2>/dev/null || true)"

# The id has to be bounded on both sides, or a longer id matches as a prefix of
# this one. herdr answers in JSON — `plugin link` prints a JSON envelope even
# without --json — so the id appears as a string value and the quotes do that
# work. The `- <id> (` rendering stays as a fallback, in case upstream renders
# text again.
registered() {
	case "$INSTALLED" in
	*"\"$1\""*) return 0 ;;
	*"- $1 "*) return 0 ;;
	*) return 1 ;;
	esac
}

link_plugin() {
	local plugin_id="$1" plugin_src="$2"

	# Unlink then link, so a stale registration (changed id or moved path) is
	# reconciled instead of silently kept.
	if registered "$plugin_id"; then
		herdr plugin unlink "$plugin_id"
	fi

	# A manifest herdr rejects must fail the script, not scroll past as one
	# warning among many.
	herdr plugin link "$plugin_src"
	echo "==> linked herdr plugin: $plugin_id -> $plugin_src"
}

# The desired set, resolved before anything is linked so the skip check below
# sees exactly what the loops act on. A vendored source missing here fails the
# apply; an optional one simply contributes nothing.
DESIRED=""
LINKED=()
for entry in "${PLUGINS[@]}"; do
	PLUGIN_ID="${entry%%|*}"
	PLUGIN_SRC="${entry#*|}"

	if [ ! -f "$PLUGIN_SRC/herdr-plugin.toml" ]; then
		echo "==> missing plugin source: $PLUGIN_SRC" >&2
		exit 1
	fi

	DESIRED+="$entry"$'\n'
	LINKED+=("$entry")
done

for entry in "${OPTIONAL_PLUGINS[@]}"; do
	PLUGIN_ID="${entry%%|*}"
	PLUGIN_SRC="${entry#*|}"

	if [ -f "$PLUGIN_SRC/herdr-plugin.toml" ]; then
		DESIRED+="$entry"$'\n'
		LINKED+=("$entry")
	fi
done

all_registered() {
	for entry in "${LINKED[@]}"; do
		registered "${entry%%|*}" || return 1
	done
	return 0
}

# Exit before herdr is touched on an already-converged host. Unlinking and
# re-linking on every apply rewrites the registry and makes herdr reload the
# plugins each run, which is real work for no change. Both halves of the test
# earn their place: the stamp catches a moved source path, which the registry
# cannot report; the registration check catches a plugin unlinked outside
# chezmoi after the stamp was written.
# `$(cat …)` drops trailing newlines while DESIRED still carries its own, so the
# comparison is against DESIRED with that newline removed; only the file keeps it.
CURRENT="$(cat "$STAMP" 2>/dev/null || true)"
if [ "$CURRENT" = "${DESIRED%$'\n'}" ] && all_registered; then
	exit 0
fi

# One line naming the half of the test that failed, so a relink during an
# otherwise silent apply is never a mystery.
if [ "$CURRENT" != "${DESIRED%$'\n'}" ]; then
	echo "==> herdr plugin set changed since the last link"
else
	echo "==> herdr lost a plugin registration; re-linking" >&2
fi

for entry in "${LINKED[@]}"; do
	PLUGIN_ID="${entry%%|*}"
	PLUGIN_SRC="${entry#*|}"
	link_plugin "$PLUGIN_ID" "$PLUGIN_SRC"
done

# A present optional plugin was handled above; what remains is the clone that has
# gone away (package uninstalled, or the repo moved owner again). Unlink it, or
# herdr keeps reporting the dangling path as "manifest unavailable".
for entry in "${OPTIONAL_PLUGINS[@]}"; do
	PLUGIN_ID="${entry%%|*}"
	PLUGIN_SRC="${entry#*|}"

	if [ ! -f "$PLUGIN_SRC/herdr-plugin.toml" ] && registered "$PLUGIN_ID"; then
		herdr plugin unlink "$PLUGIN_ID"
		echo "==> unlinked stale herdr plugin: $PLUGIN_ID (source gone: $PLUGIN_SRC)" >&2
	fi
done

# Written last, and only on the path where every link succeeded: `set -e` kills a
# failing apply before this line, so the next apply retries instead of trusting a
# half-linked host.
mkdir -p "${STAMP%/*}"
printf '%s' "$DESIRED" >"$STAMP"
