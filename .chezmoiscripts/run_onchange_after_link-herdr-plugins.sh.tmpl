#!/bin/bash
set -euo pipefail
#
# Registers locally-vendored herdr plugins with herdr. Plugin source lives in
# dot_local/share/herdr/<id> (Source state); `herdr plugin link` records the
# path in runtime state (~/.config/herdr/plugins.json), which Apply leaves
# alone. Editing this script changes its content hash and reruns it (onchange
# mechanism).
#
# Install is deferred to the user: this script runs only on `chezmoi apply`,
# links source already present on the host, and is a no-op without herdr.
#
cd "$HOME"

# herdr arrives from packages/Brewfile, so it is on PATH only once brew's bin is,
# and no script inherits shellenv from 00-bootstrap. Without this the check below
# skips the whole script on Linux while reporting success.
case "$(uname -s)" in
Darwin) eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || true)" ;;
Linux) eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || true)" ;;
esac

if ! command -v herdr >/dev/null 2>&1; then
	echo "==> herdr not installed; skipping plugin link"
	exit 0
fi

# id|source path — one entry per vendored plugin. The two are named separately
# because a directory need not match its plugin id (ghostty-theme-sync is
# upstream's directory, herdr-theme-sync is upstream's id).
PLUGINS=(
	"herdr-theme-sync|$HOME/.local/share/herdr/ghostty-theme-sync"
)

# Plugins whose source is owned by another tool, so its absence is expected
# rather than a broken apply: the tinysubagent herdr plugin ships inside the pi
# package clone for `git:github.com/tinypi-extension/tinysubagent`
# (dot_pi/agent/settings.json), which exists only once pi has installed it.
# Kept apart from PLUGINS because a missing vendored source must fail the apply
# while a missing external clone must not.
OPTIONAL_PLUGINS=(
	"tinysubagent-panes|$HOME/.pi/agent/git/github.com/tinypi-extension/tinysubagent/herdr-plugin"
)

# Read the registry once, into a variable. Piping `herdr plugin list` into
# `grep -q` looks equivalent and is not: grep exits at the first match, the
# producer dies of SIGPIPE, and under `set -o pipefail` the pipeline reports
# 141, so the unlink below is silently skipped.
INSTALLED="$(herdr plugin list 2>/dev/null || true)"

# Registry entries are listed as `- <id> (<name>) enabled [source]`, so the
# trailing space anchors the id without matching a prefix of a longer one.
registered() {
	case "$INSTALLED" in
	*"- $1 "*) return 0 ;;
	*) return 1 ;;
	esac
}

link_plugin() {
	local plugin_id="$1" plugin_src="$2"

	# Unlink then link, so a stale registration (changed id or moved path) is
	# reconciled instead of silently kept.
	if registered "$plugin_id"; then
		herdr plugin unlink "$plugin_id"
	fi

	# A manifest herdr rejects must fail the script, not scroll past as one
	# warning among many.
	herdr plugin link "$plugin_src"
	echo "==> linked herdr plugin: $plugin_id -> $plugin_src"
}

for entry in "${PLUGINS[@]}"; do
	PLUGIN_ID="${entry%%|*}"
	PLUGIN_SRC="${entry#*|}"

	if [ ! -f "$PLUGIN_SRC/herdr-plugin.toml" ]; then
		echo "==> missing plugin source: $PLUGIN_SRC" >&2
		exit 1
	fi

	link_plugin "$PLUGIN_ID" "$PLUGIN_SRC"
done

for entry in "${OPTIONAL_PLUGINS[@]}"; do
	PLUGIN_ID="${entry%%|*}"
	PLUGIN_SRC="${entry#*|}"

	if [ -f "$PLUGIN_SRC/herdr-plugin.toml" ]; then
		link_plugin "$PLUGIN_ID" "$PLUGIN_SRC"
	elif registered "$PLUGIN_ID"; then
		# The clone is gone (package uninstalled, or the repo moved owner
		# again): unlink, or herdr keeps reporting the dangling path as
		# "manifest unavailable".
		herdr plugin unlink "$PLUGIN_ID"
		echo "==> unlinked stale herdr plugin: $PLUGIN_ID (source gone: $PLUGIN_SRC)" >&2
	fi
done
