#!/bin/bash
set -euo pipefail

# pi is distributed as a pnpm global, so it cannot live in a package manifest.
# The version is pinned because dot_pi/ configuration is coupled to it; bumping
# the string below changes this script's rendered hash and re-runs it.
PI_VERSION="1.4.0"

# Neither brew's bin nor mise's shims are guaranteed here, for the reason given
# in run_onchange_setup-mise-tools.
case "$(uname -s)" in
Darwin) eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || true)" ;;
Linux) eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || true)" ;;
esac

# pnpm 12 refuses `add -g` unless its global bin directory is already on PATH,
# and it derives that directory from PNPM_HOME. Mirror dot_bashrc's value so the
# executable lands where an interactive shell already looks for it.
case "$(uname -s)" in
Darwin) export PNPM_HOME="$HOME/Library/pnpm" ;;
Linux) export PNPM_HOME="$HOME/.local/share/pnpm" ;;
esac
export PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"

# `mise activate` installs a prompt hook, and a script never draws a prompt, so
# it puts no shims on PATH here. `mise exec` resolves the tool from the global
# config instead, which needs nothing on PATH.
if ! command -v mise >/dev/null 2>&1; then
	echo "==> mise not found; 10-brew-bundle has not installed it — skipping pi" >&2
	exit 1
fi

if ! mise which pnpm >/dev/null 2>&1; then
	echo "==> pnpm not found; mise install has not provided it — skipping pi" >&2
	exit 1
fi

PNPM_BIN_DIR="$(mise exec -- pnpm bin -g 2>/dev/null || true)"
if [ -x "$PNPM_BIN_DIR/pi" ]; then
	echo "==> pi already installed; leaving it alone"
	exit 0
fi

mise exec -- pnpm add -g "@earendil-works/pi-coding-agent@${PI_VERSION}"
