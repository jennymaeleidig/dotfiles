#!/bin/bash
set -euo pipefail

# No manifest hash: this is a presence check, not a state sync. It runs until
# Homebrew exists, then no-ops on every later apply.
#
# Both hosts install Homebrew here, so 10-brew-bundle can assume the prefix it
# resolves. The Command Line Tools that the macOS installer needs come from
# 05-macos-prerequisites, which runs before this script.
# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/packages/script-env.sh"

BREW="$(brew_prefix)/bin/brew"

if [ -x "$BREW" ]; then
	echo "==> Homebrew already present"
	exit 0
fi

# An unattended apply must never hang on a sudo prompt.
require_uncached_sudo

if [ "$(uname -s)" = Darwin ]; then
	# NONINTERACTIVE=1 skips the RETURN prompt and the analytics question, so this
	# is safe inside `chezmoi apply`.
	NONINTERACTIVE=1 /bin/bash -c \
		"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

	eval "$(/opt/homebrew/bin/brew shellenv)"
	brew --version
	exit 0
fi

apt() { sudo env DEBIAN_FRONTEND=noninteractive apt-get "$@"; }

apt update
apt install -y --no-install-recommends \
	build-essential procps curl file git ca-certificates

# NONINTERACTIVE=1 skips the RETURN prompt and the analytics question, so this
# is safe inside `chezmoi apply`.
NONINTERACTIVE=1 /bin/bash -c \
	"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
brew --version
