{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# apt-packages-hash: {{ include "packages/apt-ubuntu.txt" | sha256sum }}

if ! command -v apt-get >/dev/null 2>&1; then
	echo "==> apt-get not found; nothing to do" >&2
	exit 0
fi

if ! sudo -n true 2>/dev/null; then
	echo "==> sudo needs a password: run 'sudo -v', then re-run chezmoi apply" >&2
	exit 1
fi

apt() { sudo env DEBIAN_FRONTEND=noninteractive apt-get "$@"; }

# shellcheck disable=SC1091
. /etc/os-release
CODENAME="${UBUNTU_CODENAME:-${VERSION_CODENAME}}"
ARCH="$(dpkg --print-architecture)"

# --- third-party repos, added once ------------------------------------------

# Docker Engine.
if [ ! -f /etc/apt/keyrings/docker.asc ]; then
	sudo install -m 0755 -d /etc/apt/keyrings
	curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
		| sudo tee /etc/apt/keyrings/docker.asc >/dev/null
	sudo chmod a+r /etc/apt/keyrings/docker.asc
fi
if [ ! -f /etc/apt/sources.list.d/docker.sources ]; then
	sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: ${CODENAME}
Components: stable
Architectures: ${ARCH}
Signed-By: /etc/apt/keyrings/docker.asc
EOF
fi

# Tailscale.
if [ ! -f /usr/share/keyrings/tailscale-archive-keyring.gpg ]; then
	curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/${CODENAME}.noarmor.gpg" \
		| sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
fi
if [ ! -f /etc/apt/sources.list.d/tailscale.list ]; then
	curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/${CODENAME}.tailscale-keyring.list" \
		| sudo tee /etc/apt/sources.list.d/tailscale.list >/dev/null
fi

# Visual Studio Code (Microsoft arm64 repo).
if [ ! -f /usr/share/keyrings/microsoft.gpg ]; then
	curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
		| sudo gpg --dearmor --yes -o /usr/share/keyrings/microsoft.gpg
fi
if [ ! -f /etc/apt/sources.list.d/vscode.list ]; then
	echo "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/code stable main" \
		| sudo tee /etc/apt/sources.list.d/vscode.list >/dev/null
fi

apt update

# --- manifest ---------------------------------------------------------------
# dpkg-query is the machine-readable check. `dpkg -l | grep` prints a
# human-readable format and matches substrings, so it can report a package as
# installed when only a similarly named one is.
mapfile -t WANTED < <(grep -vE '^[[:space:]]*(#|$)' "$CHEZMOI_SOURCE_DIR/packages/apt-ubuntu.txt")

MISSING=()
UNAVAILABLE=()
for pkg in "${WANTED[@]}"; do
	if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
		continue
	fi
	# Skip rather than fail when a package is absent from this release.
	if apt-cache show "$pkg" >/dev/null 2>&1; then
		MISSING+=("$pkg")
	else
		UNAVAILABLE+=("$pkg")
	fi
done

if [ "${#UNAVAILABLE[@]}" -gt 0 ]; then
	echo "==> not available on ${CODENAME}, skipped: ${UNAVAILABLE[*]}" >&2
fi

if [ "${#MISSING[@]}" -eq 0 ]; then
	echo "==> apt packages already satisfied"
	exit 0
fi

apt install -y --no-install-recommends -- "${MISSING[@]}"
{{- end -}}