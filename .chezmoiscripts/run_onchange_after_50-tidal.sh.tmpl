{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Tidal Cycles: brew provides GHC and cabal, SuperCollider synthesises, and the
# `tidal` library itself is a cabal global package that no manifest can express
# (~/.cabal/store is its only record). This script IS its manifest: changing
# TIDAL_VERSION changes the rendered hash and re-runs it. Pin an exact release:
# `"tidal-1.10"` is the version 1.10, which Hackage does not publish, and cabal
# rejects every 1.10.x release while reporting it as a conflict.
TIDAL_VERSION="1.10.3"

# ghc-pkg and cabal both live in brew's bin, which scripts do not inherit.
# shellcheck disable=SC1091
. "{{ .chezmoi.sourceDir }}/packages/script-env.sh"
brew_env

if ! command -v ghc-pkg >/dev/null 2>&1; then
	echo "==> GHC not found; aborting the apply" >&2
	exit 1
fi

if ghc -e 'putStrLn (Data.Version.showVersion Paths_tidal.version)' 2>/dev/null | grep -qx "${TIDAL_VERSION}"; then
	echo "==> tidal ${TIDAL_VERSION} already installed"
	exit 0
fi

# --lib registers the package in GHC's default environment file, which is what
# GHCi reads for `import Sound.Tidal.Context`; ghc-pkg reads package databases
# instead, so the `ghc -e` guard above asks the environment GHCi will use.
cabal update
cabal install --lib "tidal-${TIDAL_VERSION}"
{{- end -}}