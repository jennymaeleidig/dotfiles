#organized according to: https://sava.rocks/blog/how-i-organize-my-bashrc-with-imports

# mise shims - ensure available for non-interactive shells
export PATH="$HOME/.local/share/mise/shims:$PATH"

# brew
{{ if eq .chezmoi.os "darwin" -}}
if [[ -x /opt/homebrew/bin/brew ]]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
fi
# Intel Homebrew and vendored binaries still land here on macOS.
export PATH=/usr/local/bin:$PATH
{{ else -}}
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
	eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
{{ end -}}

# local binaries
export PATH="$HOME/.local/bin:$PATH"

# pnpm
{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="$HOME/Library/pnpm"
{{ else -}}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{ end -}}
case ":$PATH:" in
*":$PNPM_HOME:"*) ;;
*) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Exports, loaded for non-interactive shells too: pi and the tools it starts read
# secrets and toolchain paths from the environment, and they never reach the
# interactive-only block below.
[[ -f ~/.bash_exports ]] && source ~/.bash_exports

# Enable the subsequent settings only in interactive sessions
case $- in
*i*) ;;
*) return ;;
esac

# Source modular config files
for rc in ~/.bash_init ~/.bash_aliases; do
	[[ -f "$rc" ]] && source "$rc"
done