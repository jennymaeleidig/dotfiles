{{ $mistralEnv := env "RAYCAST_MISTRAL_API_KEY" }}
{{ $nvidiaEnv := env "RAYCAST_NVIDIA_API_KEY" }}
{{ $mistralKey := "" }}
{{ $nvidiaKey := "" }}

{{- if not $mistralEnv -}}
{{   $mistralKey = promptString "Enter your Mistral API key" -}}
{{ end -}}
{{- if not $nvidiaEnv -}}
{{   $nvidiaKey = promptString "Enter your NVIDIA API key" -}}
{{ end -}}

{{ $mistralKey = or $mistralKey $mistralEnv | default "" }}
{{ $nvidiaKey = or $nvidiaKey $nvidiaEnv | default "" }}

[data]
    raycast_mistral_api_key = {{ $mistralKey | quote }}
    raycast_nvidia_api_key = {{ $nvidiaKey | quote }}
