# User configuration

# remove switch to zsh warning
export BASH_SILENCE_DEPRECATION_WARNING=1

#vscode as default editor
export EDITOR="code"
export GIT_EDITOR="code"
export VISUAL="code"

#bat
export BAT_THEME="Monokai Pro"

# mac ports
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"

# playdate
export PLAYDATE_SDK_PATH="$HOME/Developer/PlaydateSDK"
export PATH="$HOME/Developer/PlaydateSDK/bin:$PATH"

#flash player
export FLEX_HOME="$HOME/Documents/Adobe/Flash/apache-flex-4.16.1-air-51.1.3.12/apache-flex-sdk-4.16.1-bin"

# Docker
#expose docker to colima
export DOCKER_HOST="unix://$HOME/.colima/docker.sock"

#clangd
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"

#unity
UNITY_NOPROXY=localhost,127.0.0.1

# disable context-mode idle MCP bridge shutdown (#854)
export CONTEXT_MODE_BRIDGE_IDLE_MS=0

#supercollider
export PATH="/Applications/SuperCollider.app/Contents/MacOS:$PATH"

#csharp
export PATH="$HOME/.dotnet/tools:$PATH"

#pi
export FFF_ENABLE_HOME_SCAN=0
export PI_FFF_MODE=override
export PI_MARKDOWN_PREVIEW_REGISTER_EXPORT_TOOL=false

# pi security (cc-safety-net)
export CC_SAFETY_NET_LEVEL=strict

# llama.cpp local model server. Connection only: nothing here starts a server.
# The host and port are a host fact (the llm-serve checkout's pins.json names
# the same pair and is what gate.sh checks against); keeping it literal means
# Apply never parses another repo's schema at render time.
export LLAMA_BASE_URL="http://127.0.0.1:8080"

# The llm CLI (serve | verify | url | state probe | herdr) lives in its own
# checkout, cloned to ~/.local/share/llm-serve by the .chezmoiexternal.toml
# git-repo entry; bin/ is the whole interface, so the checkout goes on PATH
# directly (docs/adr/0007-the-model-runtime-is-its-own-repo.md).
export PATH="$HOME/.local/share/llm-serve/bin:$PATH"

# No launcher functions here: `llm serve` / `llm verify` are the interface —
# the old wrappers died with the runtime's move to its own repo (ADR 0007).
# serve runs in the foreground on purpose — Ctrl-C is the stop, and there is no
# login item to forget (ADR 0005). A fresh server loads nothing until you pick
# the model with /llama in pi.
