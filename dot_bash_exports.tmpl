# User configuration

{{ if eq .chezmoi.os "darwin" -}}
# remove switch to zsh warning
export BASH_SILENCE_DEPRECATION_WARNING=1
{{ end -}}

#vscode as default editor
export EDITOR="code"
export GIT_EDITOR="code"
export VISUAL="code"

#bat
export BAT_THEME="Monokai Pro"

{{ if eq .chezmoi.os "darwin" -}}
# mac ports — appended, not prepended. brew owns the tools this repo installs,
# and MacPorts ships its own bash at /opt/local/bin/bash, which would shadow
# /opt/homebrew/bin/bash if it came first.
case ":$PATH:" in
*":/opt/local/bin:"*) ;;
*) export PATH="$PATH:/opt/local/bin:/opt/local/sbin" ;;
esac

# playdate
export PLAYDATE_SDK_PATH="$HOME/Developer/PlaydateSDK"
case ":$PATH:" in
*":$HOME/Developer/PlaydateSDK/bin:"*) ;;
*) export PATH="$HOME/Developer/PlaydateSDK/bin:$PATH" ;;
esac

#flash player
export FLEX_HOME="$HOME/Documents/Adobe/Flash/apache-flex-4.16.1-air-51.1.3.12/apache-flex-sdk-4.16.1-bin"

# Docker
#expose docker to colima
export DOCKER_HOST="unix://$HOME/.colima/docker.sock"

#clangd -- llvm is declared directly in packages/Brewfile (macOS).
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"

#supercollider
case ":$PATH:" in
*":/Applications/SuperCollider.app/Contents/MacOS:"*) ;;
*) export PATH="/Applications/SuperCollider.app/Contents/MacOS:$PATH" ;;
esac
{{ end -}}

# disable context-mode idle MCP bridge shutdown (#854)
export CONTEXT_MODE_BRIDGE_IDLE_MS=0

#csharp
case ":$PATH:" in
*":$HOME/.dotnet/tools:"*) ;;
*) export PATH="$HOME/.dotnet/tools:$PATH" ;;
esac

#pi
export FFF_ENABLE_HOME_SCAN=0
export PI_FFF_MODE=override
export PI_MARKDOWN_PREVIEW_REGISTER_EXPORT_TOOL=false

# pi security (cc-safety-net)
export CC_SAFETY_NET_LEVEL=strict

# pi incise (semantic markdown editing)
export INCISE_PROFILE=auto

# pi subagents (tinysubagent)
# A subagent pane is a child of the herdr server, not of this shell: it runs no
# login shell and no rc files, so a spawned pi never sees ~/.secrets. Prefix each
# child's command with a shell that loads the secrets first; the trailing `--`
# hands the child's pi argv to `exec "$@"`.
#
# Setting this replaces tinysubagent's direnv mechanism: `resolveLaunchPrefix`
# returns this template before it ever checks for a project `.envrc`, so a project
# that needs `.envrc` loaded inside its subagents must fold it in here, e.g.
# `direnv exec {cwd} bash -c '...' --` (`{cwd}` is substituted by tinysubagent).
export PI_HERDR_LAUNCH_PREFIX="bash -c 'set -a; [ -f \"\$HOME/.secrets/systemone.env\" ] && . \"\$HOME/.secrets/systemone.env\"; set +a; exec \"\$@\"' --"

# pi judges plus model hosting. The judge defaults to the local oMLX System One
# endpoint, `POST http://localhost:8000/v1/systemone`, model `decision` (the
# d3-nano-oQ8e alias), set once in .chezmoidata.toml. `typesafe` is the pi
# provider whose classifier dispatch speaks the System One protocol, so the
# judge-classifier extension re-registers it against the oMLX origin; pi-warden
# reaches the same endpoint through an endpoint object.
#
#   OMLX_SYSTEMONE_KEY  oMLX's `auth.api_key`, from the unmanaged
#                       ~/.secrets/systemone.env below; no file means no
#                       export. oMLX serves /v1/systemone without auth, but
#                       pi-typesafe still requires a nonempty key to consider
#                       the provider usable, so the variable must exist.
#
# The remote chat models are a separate credential: `pi --online` (the launch
# wrapper in ~/.config/bash/pi-launch.sh) and `/online` (the host-toggle extension) use pi's
# `opencode-go` provider, which reads:
#
#   OPENCODE_API_KEY     pi's `opencode-go` provider (deepseek-v4.1-flash,
#                       glm-5.3). Get it from https://opencode.ai/console and
#                       put it in the unmanaged systemone.env below; no file
#                       means no export.
#
# The key names in .chezmoidata.toml and this file must match. A judge key
# must never be TYPESAFE_API_KEY: pi-typesafe refuses an endpoint object that
# names the TypeSafe key, which only ever goes to api.typesafe.ai.
#
# `set -a` exports them so extensions and child panes read them from process.env.
set -a
[ -f "$HOME/.secrets/systemone.env" ] && . "$HOME/.secrets/systemone.env"

# pi launches local by default: the oMLX server at localhost:8000 serves the
# main model, and the judge block above serves the classifier. `pi --online`
# goes full remote: the chat model from [chat.remote] and the judge from
# [judge.online] (tinysubagent via PI_TINYSUBAGENT_CONFIG, pi-warden via a
# config swap — per-launch, since both read their config once at load). Inside
# a session, `/online` and `/offline` (host-toggle extension) switch only the
# chat model; the judge stays as launched until the next `pi`. Everything else
# — settings, subagent inheritance, tinysubagent config — is shared: only the
# model hosting default moves. The routing function itself lives in
# ~/.config/bash/pi-launch.sh (rendered from .chezmoidata.toml's
# [chat.local]/[chat.remote] tables, same as host-toggle) so this file stays
# declarative exports.
. "$HOME/.config/bash/pi-launch.sh"
set +a
