# pi incise (semantic markdown editing)
export INCISE_PROFILE=auto

# pi subagents (tinysubagent)
# A subagent pane is a child of the herdr server, not of this shell: it runs no
# login shell and no rc files, so a spawned pi never sees ~/.secrets. Prefix each
# child's command with a shell that loads the secrets first; the trailing `--`
# hands the child's pi argv to `exec "$@"`.
#
# Setting this replaces tinysubagent's direnv mechanism: `resolveLaunchPrefix`
# returns this template before it ever checks for a project `.envrc`, so a project
# that needs `.envrc` loaded inside its subagents must fold it in here, e.g.
# `direnv exec {cwd} bash -c '...' --` (`{cwd}` is substituted by tinysubagent).
export PI_HERDR_LAUNCH_PREFIX="bash -c 'set -a; [ -f \"\$HOME/.secrets/systemone.env\" ] && . \"\$HOME/.secrets/systemone.env\"; set +a; exec \"\$@\"' --"

# pi judges, one credential for every consumer. Today the judge is TypeSafe's
# Jev, `POST https://api.typesafe.ai/v1/systemone`, model `jev-latest`, set once
# in .chezmoidata.toml.
#
#   TYPESAFE_API_KEY  pi's `typesafe` classifier provider (tinysubagent's
#                     `classifierModel` for profile routing and the child report
#                     check) and pi-warden's built-in judgment backend. The value
#                     comes from https://console.typesafe.ai/keys and lives in the
#                     unmanaged systemone.env below; no file means no export.
#
# A local System One endpoint exports its own `keyEnv` here instead; the key
# names in .chezmoidata.toml and this file must match. That variable must not be
# TYPESAFE_API_KEY: pi-typesafe refuses an endpoint object that names the TypeSafe
# key, which only ever goes to api.typesafe.ai.
#
# `set -a` exports them so extensions and child panes read them from process.env.
set -a
[ -f "$HOME/.secrets/systemone.env" ] && . "$HOME/.secrets/systemone.env"
set +a
