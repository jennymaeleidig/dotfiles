# User configuration

{{ if eq .chezmoi.os "darwin" -}}
# remove switch to zsh warning
export BASH_SILENCE_DEPRECATION_WARNING=1
{{ end -}}

#vscode as default editor
export EDITOR="code"
export GIT_EDITOR="code"
export VISUAL="code"

#bat
export BAT_THEME="Monokai Pro"

{{ if eq .chezmoi.os "darwin" -}}
# mac ports — appended, not prepended. brew owns the tools this repo installs,
# and MacPorts ships its own bash at /opt/local/bin/bash, which would shadow
# /opt/homebrew/bin/bash if it came first.
case ":$PATH:" in
*":/opt/local/bin:"*) ;;
*) export PATH="$PATH:/opt/local/bin:/opt/local/sbin" ;;
esac

# playdate
export PLAYDATE_SDK_PATH="$HOME/Developer/PlaydateSDK"
case ":$PATH:" in
*":$HOME/Developer/PlaydateSDK/bin:"*) ;;
*) export PATH="$HOME/Developer/PlaydateSDK/bin:$PATH" ;;
esac

#flash player
export FLEX_HOME="$HOME/Documents/Adobe/Flash/apache-flex-4.16.1-air-51.1.3.12/apache-flex-sdk-4.16.1-bin"

# Docker
#expose docker to colima
export DOCKER_HOST="unix://$HOME/.colima/docker.sock"

#clangd -- llvm is declared directly in packages/Brewfile (macOS).
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"

#supercollider
case ":$PATH:" in
*":/Applications/SuperCollider.app/Contents/MacOS:"*) ;;
*) export PATH="/Applications/SuperCollider.app/Contents/MacOS:$PATH" ;;
esac
{{ end -}}

# disable context-mode idle MCP bridge shutdown (#854)
export CONTEXT_MODE_BRIDGE_IDLE_MS=0

#csharp
case ":$PATH:" in
*":$HOME/.dotnet/tools:"*) ;;
*) export PATH="$HOME/.dotnet/tools:$PATH" ;;
esac

#pi
export FFF_ENABLE_HOME_SCAN=0
export PI_FFF_MODE=override
export PI_MARKDOWN_PREVIEW_REGISTER_EXPORT_TOOL=false

# pi security (cc-safety-net)
export CC_SAFETY_NET_LEVEL=strict

# pi incise (semantic markdown editing)
export INCISE_PROFILE=auto

# pi subagents (tinysubagent)
# A subagent pane is a child of the herdr server, not of this shell: it runs no
# login shell and no rc files, so a spawned pi never sees ~/.secrets. Prefix each
# child's command with a shell that loads the secrets first; the trailing `--`
# hands the child's pi argv to `exec "$@"`.
#
# Setting this replaces tinysubagent's direnv mechanism: `resolveLaunchPrefix`
# returns this template before it ever checks for a project `.envrc`, so a project
# that needs `.envrc` loaded inside its subagents must fold it in here, e.g.
# `direnv exec {cwd} bash -c '...' --` (`{cwd}` is substituted by tinysubagent).
export PI_HERDR_LAUNCH_PREFIX="bash -c 'set -a; [ -f \"\$HOME/.secrets/systemone.env\" ] && . \"\$HOME/.secrets/systemone.env\"; set +a; exec \"\$@\"' --"

# pi judges, one credential for every consumer. Today the judge is OpenCode's
# Jev, `POST https://opencode.ai/inference/systemone/v1/systemone`, model
# `jev-1.13`, set once in .chezmoidata.toml. pi ships
# `opencode/jev-1.13` as a classifier model, and pi-warden reaches the same
# host through an endpoint object.
#
#   OPENCODE_API_KEY  pi's `opencode` provider (tinysubagent's `classifierModel`
#                     for profile routing and the child report check) and
#                     pi-warden's judgment endpoint. Get it from
#                     https://opencode.ai/console and put it in the unmanaged
#                     systemone.env below; no file means no export.
#
# A local System One endpoint exports its own `keyEnv` here instead (the oMLX
# path used `OMLX_SYSTEMONE_KEY`, oMLX's `auth.api_key`); the key names in
# .chezmoidata.toml and this file must match. That variable must not be
# TYPESAFE_API_KEY: pi-typesafe refuses an endpoint object that names the TypeSafe
# key, which only ever goes to api.typesafe.ai.
#
# `set -a` exports them so extensions and child panes read them from process.env.
set -a
[ -f "$HOME/.secrets/systemone.env" ] && . "$HOME/.secrets/systemone.env"
set +a