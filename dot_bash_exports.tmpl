# User configuration

# remove switch to zsh warning
export BASH_SILENCE_DEPRECATION_WARNING=1

#vscode as default editor
export EDITOR="code"
export GIT_EDITOR="code"
export VISUAL="code"

#bat
export BAT_THEME="Monokai Pro"

# mac ports
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"

# playdate
export PLAYDATE_SDK_PATH="$HOME/Developer/PlaydateSDK"
export PATH="$HOME/Developer/PlaydateSDK/bin:$PATH"

#flash player
export FLEX_HOME="$HOME/Documents/Adobe/Flash/apache-flex-4.16.1-air-51.1.3.12/apache-flex-sdk-4.16.1-bin"

# Docker
#expose docker to colima
export DOCKER_HOST="unix://$HOME/.colima/docker.sock"

#clangd
export LDFLAGS="-L/opt/homebrew/opt/llvm/lib"
export CPPFLAGS="-I/opt/homebrew/opt/llvm/include"

#unity
UNITY_NOPROXY=localhost,127.0.0.1

# disable context-mode idle MCP bridge shutdown (#854)
export CONTEXT_MODE_BRIDGE_IDLE_MS=0

#supercollider
export PATH="/Applications/SuperCollider.app/Contents/MacOS:$PATH"

#csharp
export PATH="$HOME/.dotnet/tools:$PATH"

#pi
export FFF_ENABLE_HOME_SCAN=0
export PI_FFF_MODE=override
export PI_MARKDOWN_PREVIEW_REGISTER_EXPORT_TOOL=false

# pi security (cc-safety-net)
export CC_SAFETY_NET_LEVEL=strict

# pi subagents (tinysubagent)
# A subagent pane is a child of the herdr server, not of this shell: it runs no
# login shell and no rc files, so a spawned pi never sees ~/.secrets. Prefix each
# child's command with a shell that loads the secrets first; the trailing `--`
# hands the child's pi argv to `exec "$@"`.
#
# Setting this replaces tinysubagent's direnv mechanism: `resolveLaunchPrefix`
# returns this template before it ever checks for a project `.envrc`, so a project
# that needs `.envrc` loaded inside its subagents must fold it in here, e.g.
# `direnv exec {cwd} bash -c '...' --` (`{cwd}` is substituted by tinysubagent).
export PI_HERDR_LAUNCH_PREFIX="bash -c 'set -a; [ -f \"\$HOME/.secrets/typesafe.env\" ] && . \"\$HOME/.secrets/typesafe.env\"; set +a; exec \"\$@\"' --"

# pi judges, all on TypeSafe's own endpoint: `TYPESAFE_API_KEY` for pi-warden and
# tinysubagent's `classifierModel` routing (resolved by pi's built-in TypeSafe
# classifier provider), and `SYSTEM_ONE_*` for pi-system-one's `system_one` tool.
# The values stay in unmanaged files below, never in source
# state; `set -a` exports them so extensions read them from process.env, and no
# file means no exports. `typesafe.env` is sourced last, so it pins the endpoint
# and model over anything an earlier file set.
set -a
[ -f "$HOME/.secrets/system-one.env" ] && . "$HOME/.secrets/system-one.env"
[ -f "$HOME/.secrets/typesafe.env" ] && . "$HOME/.secrets/typesafe.env"
set +a
