# aliases
alias pico8="/Applications/PICO-8.app/Contents/MacOS/pico8; exit"
alias hg="history | grep"
alias cat="bat --paging=never"
alias grep="rg"
alias ls="eza"
alias cd="z"
alias cdi="zi"
alias tsvmd="csvmd --delimiter=$'\t'"

# feynman always runs inside a microsandbox microVM configured by
# ~/.config/feynman/sandbox.yaml. FEYNMAN_NATIVE=1 escapes to the host binary
# for host-side maintenance (if the native install is still present). Runs
# outside $HOME mount the working directory at /workspace inside the VM.
feynman() {
	if [ "${FEYNMAN_NATIVE:-0}" != "1" ] && ! command -v msb >/dev/null 2>&1; then
		echo "feynman: msb not found; falling back to native feynman (install microsandbox to sandbox it)" >&2
		command feynman "$@"
		return
	fi
	if [ "${FEYNMAN_NATIVE:-0}" = "1" ]; then
		command feynman "$@"
		return
	fi
	# Re-assert the declared guest pi config (extensions/settings/keybindings)
	# before launch — a fast no-op when the target already matches.
	"$HOME/.local/bin/feynman-pi-sync" >/dev/null 2>&1 || true
	local dir="$(pwd -P)"
	if [ "$dir" != "$HOME" ] && [ -d "$dir" ]; then
		msb run --conf "$HOME/.config/feynman/sandbox.yaml" -v "$dir:/workspace" -w /workspace -- feynman "$@"
	else
		msb run --conf "$HOME/.config/feynman/sandbox.yaml" -- feynman "$@"
	fi
}
