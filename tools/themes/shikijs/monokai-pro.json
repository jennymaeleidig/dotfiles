  "tokenColors": [
    {
      "settings": {
        "foreground": "#FCFCFA"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#FCFCFA"
      }
    },
    {
      "scope": "comment",
      "settings": {
        "foreground": "#727072"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#FFD866"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FF6188"
      }
    },
    {
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#FCFCFA"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#AB9DF2"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#AB9DF2"
      }
    },
    {
      "scope": "constant.character, constant.other",
      "settings": {
        "foreground": "#AB9DF2"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#FCFCFA"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#FF6188"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#FF6188"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#78DCE8"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, entity.name.namespace, entity.name.scope-resolution",
      "settings": {
        "fontStyle": "underline",
        "foreground": "#A9DC76"
      }
    },
    {
      "scope": [
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "fontStyle": "italic underline",
        "foreground": "#A9DC76"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#A9DC76"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#FC9867"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "fontStyle": "",
        "foreground": "#FF6188"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "fontStyle": "",
        "foreground": "#A9DC76"
      }
    },
    {
      "scope": "support.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#78DCE8"
      }
    },
    {
      "scope": "support.constant",
      "settings": {
        "fontStyle": "",
        "foreground": "#78DCE8"
      }
    },
    {
      "scope": "support.type, support.class",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#78DCE8"
      }
    },
    {
      "scope": "support.other.variable",
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "fontStyle": "",
        "foreground": "#FF6188"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#FF6188"
      }
    },
    {
