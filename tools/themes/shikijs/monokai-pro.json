      "settings": {
        "foreground": "#A9DC76"
      }
    },
    {
      "scope": "token.info-token",
      "settings": {
        "foreground": "#78dce8"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#fc9867"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "scope": "variable.language",
      "settings": {
        "foreground": "#FC9867"
      }
    }
  ]
